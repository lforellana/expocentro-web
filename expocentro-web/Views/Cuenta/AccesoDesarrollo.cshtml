@model List<Usuario>
@{
    ViewData["Title"] = "Acceso de prueba";
    Layout = "_LayoutAcceso";
}

<h1 class="h5 fw-bold mb-1">Acceso de prueba</h1>
<p class="text-muted small mb-3">
    Microsoft Entra ID no está configurado en este ambiente. Elige un usuario para probar el sistema con su rol.
</p>

<form asp-action="AccesoDesarrollo" method="post">
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
    <div class="list-group mb-3">
        @foreach (var u in Model)
        {
            <button type="submit" name="usuarioId" value="@u.Id"
                    class="list-group-item list-group-item-action d-flex align-items-center gap-3 py-3">
                <span class="app-avatar" style="background:var(--ex-primary)">@u.Nombre[0]</span>
                <span class="flex-grow-1 text-start">
                    <span class="fw-semibold d-block">@u.Nombre</span>
                    <span class="small text-muted">@u.Rol · @u.Departamento.Nombre</span>
                </span>
                <i class="bi bi-chevron-right text-muted"></i>
            </button>
        }
    </div>
</form>

<div class="alert alert-warning small mb-0">
    <i class="bi bi-shield-exclamation me-1"></i>
    Solo para desarrollo y pruebas. En producción configure la sección <code>AzureAd</code>.
</div>
