@{
    ViewData["Title"] = "Servicios";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">
            Servicios
        </h1>

        <p class="lead text-muted">
            Conoce los servicios disponibles para complementar
            la realización de tu evento.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">

                    <h2 class="h4">
                        Montaje
                    </h2>

                    <p>
                        Opciones de configuración de espacios
                        según las características del evento.
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">

                    <h2 class="h4">
                        Audiovisuales
                    </h2>

                    <p>
                        Soluciones audiovisuales disponibles
                        para reuniones y eventos.
                    </p>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">

                    <h2 class="h4">
                        Apoyo para eventos
                    </h2>

                    <p>
                        Servicios complementarios para apoyar
                        la organización de actividades.
                    </p>

                </div>
            </div>
        </div>

    </div>

</div>