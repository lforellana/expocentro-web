@model Expocentro.Web.ViewModels.HomeDashboardViewModel

@{
    ViewData["Title"] = "Inicio";
}

<div class="container py-4">

    <!-- BANNER PRINCIPAL -->

    <section class="dashboard-hero mb-4">

        <div class="dashboard-hero-overlay"></div>

        <div class="dashboard-hero-content">

            <span class="badge bg-light text-dark mb-3">
                Expocentro · CCIC
            </span>

            <h1 class="fw-bold text-white mb-2">
                Gestión de eventos internos
            </h1>

            <p class="text-white mb-1 fs-5">
                Bienvenido, @Model.NombreUsuario
            </p>

            <p class="text-white-50 mb-4">
                Registra y da seguimiento a tus solicitudes
                de eventos internos.
            </p>

            <div class="d-flex flex-wrap gap-2">

                <a asp-controller="Solicitudes"
                   asp-action="Create"
                   class="btn btn-primary btn-lg">

                    + Solicitar nuevo evento

                </a>

                <a asp-controller="Solicitudes"
                   asp-action="Index"
                   class="btn btn-light btn-lg">

                    Mis solicitudes

                </a>

            </div>

        </div>

    </section>


    <!-- RESUMEN -->

   <div class="row g-3 mb-4">

    <div class="col-md-6 col-xl">

        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">
                    Total
                </p>

                <div class="display-6 fw-bold">
                    @Model.TotalSolicitudes
                </div>
            </div>
        </div>

    </div>

    <div class="col-md-6 col-xl">

        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <p class="text-muted mb-2">
                    Borradores
                </p>

                <div class="display-6 fw-bold text-secondary">
                    @Model.TotalBorradores
                </div>
            </div>
        </div>

    </div>

</div>


    <!-- ACCESOS RÁPIDOS -->

    <div class="row g-3 mb-5">

        <div class="col-md-6">

            <a asp-controller="Solicitudes"
               asp-action="Create"
               class="text-decoration-none text-dark">

                <div class="card dashboard-action-card
                            border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <div class="fs-2 mb-3">
                            +
                        </div>

                        <h2 class="h5 fw-bold">
                            Nueva solicitud
                        </h2>

                        <p class="text-muted mb-0">
                            Registra una nueva solicitud
                            de evento interno.
                        </p>

                    </div>

                </div>

            </a>

        </div>


        <div class="col-md-6">

            <a asp-controller="Solicitudes"
               asp-action="Index"
               class="text-decoration-none text-dark">

                <div class="card dashboard-action-card
                            border-0 shadow-sm h-100">

                    <div class="card-body p-4">

                        <div class="fs-2 mb-3">
                            ≡
                        </div>

                        <h2 class="h5 fw-bold">
                            Mis solicitudes
                        </h2>

                        <p class="text-muted mb-0">
                            Consulta el estado de los eventos
                            que has registrado.
                        </p>

                    </div>

                </div>

            </a>

        </div>

    </div>


    <!-- SOLICITUDES RECIENTES -->

    <div class="d-flex justify-content-between
                align-items-center mb-3">

        <div>

            <h2 class="h4 fw-bold mb-1">
                Solicitudes recientes
            </h2>

            <p class="text-muted mb-0">
                Últimos eventos registrados.
            </p>

        </div>

        <a asp-controller="Solicitudes"
           asp-action="Index"
           class="btn btn-outline-primary">

            Ver todas

        </a>

    </div>


    <div class="card border-0 shadow-sm">

        @if (Model.SolicitudesRecientes.Any())
        {
            <div class="table-responsive">

                <table class="table table-hover
                              align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>Código</th>
                            <th>Evento</th>
                            <th>Fecha</th>
                            <th>Salón</th>
                            <th>Estado</th>
                        </tr>

                    </thead>

                    <tbody>

                    @foreach (var solicitud in Model.SolicitudesRecientes)
{
    var estadoTexto = solicitud.Estado.Nombre;

    var badgeClass = estadoTexto switch
    {
        "Borrador" => "bg-secondary",
        "Enviada" => "bg-primary",
        "En revisión" => "bg-warning text-dark",
        "Aprobada" => "bg-success",
        "Rechazada" => "bg-danger",
        _ => "bg-dark"
    };

    <tr>
        <td>
            @solicitud.Codigo
        </td>

        <td class="fw-semibold">
            @solicitud.NombreEvento
        </td>

        <td>
            @solicitud.FechaHoraInicio.ToString("dd/MM/yyyy")
        </td>

        <td>
            @solicitud.Salon.Nombre
        </td>

        <td>
            <span class="badge @badgeClass px-3 py-2">
                @estadoTexto
            </span>
        </td>
    </tr>
}

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="card-body text-center py-5">

                <h3 class="h5">
                    Todavía no tienes solicitudes
                </h3>

                <p class="text-muted">
                    Registra tu primer evento interno
                    para comenzar.
                </p>

                <a asp-controller="Solicitudes"
                   asp-action="Create"
                   class="btn btn-primary">

                    + Nueva solicitud

                </a>

            </div>
        }

    </div>

</div>