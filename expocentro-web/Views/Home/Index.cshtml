@{
    ViewData["Title"] = "Expocentro";
}

<section class="py-5">
    <span class="badge bg-primary mb-3">Expocentro · CCIC</span>

    <h1 class="display-4 fw-bold">
        Un espacio para tu próximo evento
    </h1>

    <p class="lead">
        Conoce las instalaciones para eventos y convenciones
        de la Cámara de Comercio e Industrias de Cortés.
    </p>

    <a href="#espacios" class="btn btn-primary btn-lg">
        Explorar espacios
    </a>
</section>

<section id="espacios" class="pb-5">
    <h2 class="mb-4">Nuestros espacios</h2>

    <div class="row g-4">
        <div class="col-md-6">
            <article class="card h-100">
                <div class="card-body">
                    <h3 class="h4">Salones para eventos</h3>
                    <p class="mb-0">
                        Espacios para reuniones, convenciones
                        y actividades empresariales.
                    </p>
                </div>
            </article>
        </div>

        <div class="col-md-6">
            <article class="card h-100">
                <div class="card-body">
                    <h3 class="h4">Áreas al aire libre</h3>
                    <p class="mb-0">
                        Áreas para diferentes formatos
                        de actividades y encuentros.
                    </p>
                </div>
            </article>
        </div>
    </div>
</section>