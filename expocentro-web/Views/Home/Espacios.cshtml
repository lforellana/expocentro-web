@{
    ViewData["Title"] = "Espacios";
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold">Nuestros espacios</h1>

        <p class="lead text-muted">
            Conoce los espacios disponibles en Expocentro para
            reuniones, congresos, exposiciones y eventos.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">

                <div class="card-body">
                    <h2 class="h4">Salón de eventos</h2>

                    <p>
                        Espacio adaptable para reuniones empresariales,
                        capacitaciones y eventos especiales.
                    </p>

                    <a href="#" class="btn btn-outline-primary">
                        Ver detalles
                    </a>
                </div>

            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm">

                <div class="card-body">
                    <h2 class="h4">Área para exposiciones</h2>

                    <p>
                        Espacios destinados a exposiciones,
                        ferias comerciales y actividades empresariales.
                    </p>

                    <a href="#" class="btn btn-outline-primary">
                        Ver detalles
                    </a>
                </div>

            </div>
        </div>

    </div>

</div>