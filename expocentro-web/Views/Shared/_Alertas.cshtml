@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success d-flex align-items-start gap-2 alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill mt-1"></i>
        <div>@mensaje</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger d-flex align-items-start gap-2 alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div>@error</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
