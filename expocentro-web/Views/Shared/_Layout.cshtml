<!DOCTYPE html>
@inject Expocentro.Web.Data.ApplicationDbContext Db
@inject Expocentro.Web.Seguridad.ModoAutenticacion ModoAuth
@using Microsoft.EntityFrameworkCore
@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    var esCoordinador = autenticado && User.EsCoordinador();
    var esAdmin = autenticado && User.EsAdministrador();
    var nombre = autenticado ? User.ObtenerNombre() : "";
    var iniciales = string.Concat(nombre
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(p => char.ToUpperInvariant(p[0])));

    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();

    string Activo(string c, string? a = null) =>
        string.Equals(controlador, c, StringComparison.OrdinalIgnoreCase)
        && (a == null || string.Equals(accion, a, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";

    var pendientes = esCoordinador
        ? await Db.SolicitudesEvento.CountAsync(x => x.Estado.Nombre == Estados.Enviada)
        : 0;

    var rolTexto = esAdmin ? "Administrador" : esCoordinador ? "Coordinación" : "Solicitante";
}
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Expocentro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
<div class="app-shell">

    <aside class="app-sidebar" id="sidebar">

        <a class="app-brand" asp-controller="Home" asp-action="Index">
            <span class="app-brand-logo">E</span>
            <span class="app-brand-text">
                <strong>Expocentro</strong>
                <small>Gestión de eventos · CCIC</small>
            </span>
        </a>

        <nav class="app-nav">

            @if (autenticado)
            {
                <a class="@Activo("Home", "Index")" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house"></i> Inicio
                </a>
                <a class="@Activo("Calendario")" asp-controller="Calendario" asp-action="Index">
                    <i class="bi bi-calendar3"></i> Calendario de salones
                </a>

                <div class="app-nav-title">Mis eventos</div>
                <a class="@(accion == "Create" && controlador == "Solicitudes" ? "active" : "")"
                   asp-controller="Solicitudes" asp-action="Create">
                    <i class="bi bi-plus-circle"></i> Nueva solicitud
                </a>
                <a class="@(controlador == "Solicitudes" && accion != "Create" ? "active" : "")"
                   asp-controller="Solicitudes" asp-action="Index">
                    <i class="bi bi-card-checklist"></i> Mis solicitudes
                </a>

                @if (esCoordinador)
                {
                    <div class="app-nav-title">Coordinación</div>
                    <a class="@Activo("Coordinacion")" asp-controller="Coordinacion" asp-action="Index">
                        <i class="bi bi-inbox"></i> Bandeja de solicitudes
                        @if (pendientes > 0)
                        {
                            <span class="nav-count">@pendientes</span>
                        }
                    </a>
                    <a class="@Activo("EventosExternos")" asp-controller="EventosExternos" asp-action="Create">
                        <i class="bi bi-building-add"></i> Registrar evento externo
                    </a>
                }

                @if (esAdmin)
                {
                    <div class="app-nav-title">Administración</div>
                    <a class="@Activo("Usuarios")" asp-controller="Usuarios" asp-action="Index">
                        <i class="bi bi-people"></i> Usuarios
                    </a>
                }
            }

            <div class="app-nav-title">Expocentro</div>
            <a class="@Activo("Home", "Espacios")" asp-controller="Home" asp-action="Espacios">
                <i class="bi bi-grid-1x2"></i> Espacios
            </a>
            <a class="@Activo("Home", "Servicios")" asp-controller="Home" asp-action="Servicios">
                <i class="bi bi-stars"></i> Servicios
            </a>
            <a class="@Activo("Home", "ComoLlegar")" asp-controller="Home" asp-action="ComoLlegar">
                <i class="bi bi-geo-alt"></i> Cómo llegar
            </a>
            <a class="@Activo("Cotizacion")" asp-controller="Cotizacion" asp-action="Index">
                <i class="bi bi-receipt"></i> Solicitar cotización
            </a>
        </nav>

        @if (autenticado)
        {
            <div class="app-user">
                <span class="app-avatar">@iniciales</span>
                <div class="app-user-info">
                    <strong title="@nombre">@nombre</strong>
                    <small>@rolTexto@(ModoAuth.EsDesarrollo ? " · modo prueba" : "")</small>
                </div>
                <form asp-controller="Cuenta" asp-action="Salir" method="post">
                    <button type="submit" class="btn-salir" title="Cerrar sesión">
                        <i class="bi bi-box-arrow-right fs-5"></i>
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="app-user">
                <a class="btn btn-primary w-100" asp-controller="Cuenta" asp-action="Entrar">
                    <i class="bi bi-microsoft me-1"></i> Iniciar sesión
                </a>
            </div>
        }
    </aside>

    <div class="app-backdrop" id="sidebarBackdrop"></div>

    <div class="app-main">

        <header class="app-topbar">
            <button class="btn btn-sm" type="button" id="sidebarToggle" aria-label="Abrir menú">
                <i class="bi bi-list fs-4"></i>
            </button>
            <strong>Expocentro</strong>
            <span class="app-avatar">@iniciales</span>
        </header>

        <main class="app-content">
            @RenderBody()
        </main>

        <footer class="app-footer">
            &copy; @DateTime.Now.Year Expocentro · Cámara de Comercio e Industrias de Cortés
        </footer>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
