@model RechazarSolicitudViewModel
@{
    ViewData["Title"] = "Rechazar solicitud";
}

<div class="page-header">
    <div>
        <div class="page-kicker">
            <a asp-action="Details" asp-route-id="@Model.SolicitudEventoId" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Volver</a>
            · @Model.Codigo
        </div>
        <h1>Rechazar solicitud</h1>
        <p>@Model.NombreEvento</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8 col-xl-6">
        <form asp-action="Rechazar" method="post" class="ex-card ex-card-body">
            <input asp-for="SolicitudEventoId" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <label asp-for="Motivo" class="form-label"></label>
            <textarea asp-for="Motivo" class="form-control" rows="5" autofocus
                      placeholder="Explica el motivo y, si es posible, sugiere otra fecha o salón disponible."></textarea>
            <span asp-validation-for="Motivo" class="text-danger small"></span>
            <div class="form-text">El solicitante verá este mensaje en el historial de su solicitud.</div>

            <div class="form-acciones">
                <a asp-action="Details" asp-route-id="@Model.SolicitudEventoId" class="btn btn-light">Cancelar</a>
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-x-circle me-1"></i> Confirmar rechazo
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
