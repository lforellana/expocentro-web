@model IEnumerable<Expocentro.Web.Models.SolicitudEvento>

@{
    ViewData["Title"] = "Coordinación de eventos";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Coordinación de eventos
            </h1>

            <p class="text-muted mb-0">
                Solicitudes enviadas para revisión.
            </p>
        </div>

    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    <div class="card border-0 shadow-sm">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Código</th>
                        <th>Evento</th>
                        <th>Solicitante</th>
                        <th>Departamento</th>
                        <th>Fecha</th>
                        <th>Salón</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>

                </thead>

                <tbody>

                @foreach (var solicitud in Model)
                {
                    var badgeClass = solicitud.Estado.Nombre switch
                    {
                        "Enviada" => "bg-primary",
                        "En revisión" => "bg-warning text-dark",
                        "Aprobada" => "bg-success",
                        "Rechazada" => "bg-danger",
                        _ => "bg-secondary"
                    };

                    <tr>

                        <td>
                            @solicitud.Codigo
                        </td>

                        <td class="fw-semibold">
                            @solicitud.NombreEvento
                        </td>

                        <td>
                            @solicitud.SolicitanteUsuario.Nombre
                        </td>

                        <td>
                            @solicitud.DepartamentoCargo.Nombre
                        </td>

                        <td>
                            @solicitud.FechaHoraInicio.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @solicitud.Salon.Nombre
                        </td>

                        <td>
                            <span class="badge @badgeClass">
                                @solicitud.Estado.Nombre
                            </span>
                        </td>

                        <td>
                            <a asp-action="Details"
                               asp-route-id="@solicitud.Id"
                               class="btn btn-sm btn-outline-primary">
                                Revisar
                            </a>
                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

</div>