@model SolicitudEvento
@{
    ViewData["Title"] = Model.NombreEvento;

    var estado = Model.Estado.Nombre;
    var disponibilidad = ViewData["Disponibilidad"] as ResultadoDisponibilidad;
    var pendiente = estado is Estados.Enviada or Estados.EnRevision;
    var esExterno = Model.TipoEvento == TipoEvento.Externo;
    var cancelable = Estados.Cancelables.Contains(estado) && estado != Estados.Borrador;
    var bloqueado = disponibilidad?.HayConflictoConfirmado == true;
}

<div class="page-header">
    <div>
        <div class="page-kicker">
            <a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Bandeja</a>
            · @Model.Codigo
        </div>
        <h1>@Model.NombreEvento</h1>
        <p>@Fechas.Rango(Model.FechaHoraInicio, Model.FechaHoraFin) · @Model.Salon.Nombre</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <partial name="_TipoEvento" model="Model.TipoEvento" />
        <partial name="_EstadoBadge" model="estado" />
    </div>
</div>

<partial name="_Alertas" />

@if (disponibilidad != null && (pendiente || estado == Estados.Aprobada))
{
    <partial name="_Conflictos" model="disponibilidad" />
}

<div class="row g-4">
    <div class="col-xl-8">
        @{ ViewData["EnlacesEdicion"] = false; }
        <partial name="_DetalleEvento" model="Model" />
    </div>

    <div class="col-xl-4">

        @if (pendiente)
        {
            <section class="ex-card ex-card-body mb-4">
                <h2 class="ex-section-title"><i class="bi bi-clipboard-check"></i> Decisión</h2>

                @if (estado == Estados.Enviada)
                {
                    <form asp-action="Revisar" asp-route-id="@Model.Id" method="post" class="mb-3">
                        <button type="submit" class="btn btn-outline-primary w-100">
                            <i class="bi bi-hourglass-split me-1"></i> Tomar para revisión
                        </button>
                        <div class="form-text">Avisa al solicitante que ya la estás atendiendo.</div>
                    </form>
                }

                <form asp-action="Aprobar" asp-route-id="@Model.Id" method="post">
                    <label class="form-label small" for="comentario">Comentario para el solicitante (opcional)</label>
                    <textarea class="form-control mb-2" id="comentario" name="comentario" rows="2" maxlength="500"></textarea>
                    <button type="submit" class="btn btn-success w-100" disabled="@bloqueado">
                        <i class="bi bi-check-circle me-1"></i> Aprobar y reservar salón
                    </button>
                    @if (bloqueado)
                    {
                        <div class="form-text text-danger">No se puede aprobar: el salón ya está reservado.</div>
                    }
                </form>

                <a asp-action="Rechazar" asp-route-id="@Model.Id" class="btn btn-outline-danger w-100 mt-2">
                    <i class="bi bi-x-circle me-1"></i> Rechazar
                </a>
            </section>
        }

        @if (esExterno && estado == Estados.Aprobada)
        {
            <a asp-controller="EventosExternos" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary w-100 mb-4">
                <i class="bi bi-pencil me-1"></i> Editar evento externo
            </a>
        }

        <partial name="_Historial" model="Model.HistorialEstados" />

        @if (cancelable)
        {
            <div class="text-center mt-3">
                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalCancelar">
                    <i class="bi bi-slash-circle me-1"></i> Cancelar evento
                </button>
            </div>
        }
    </div>
</div>

@if (cancelable)
{
    <partial name="_CancelarModal" model='("Coordinacion", Model.Id, true)' />
}
