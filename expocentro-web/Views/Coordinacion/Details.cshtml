@model Expocentro.Web.Models.SolicitudEvento

@{
    ViewData["Title"] = "Revisión de solicitud";

    var badgeClass = Model.Estado.Nombre switch
    {
        "Enviada" => "bg-primary",
        "En revisión" => "bg-warning text-dark",
        "Aprobada" => "bg-success",
        "Rechazada" => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="container py-5">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <p class="text-muted mb-1">
                @Model.Codigo
            </p>

            <h1 class="fw-bold mb-1">
                @Model.NombreEvento
            </h1>

            <p class="text-muted mb-0">
                Revisión de solicitud de evento
            </p>
        </div>

        <span class="badge @badgeClass px-3 py-2">
            @Model.Estado.Nombre
        </span>

    </div>


    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }


    <!-- DATOS GENERALES -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">
                Datos generales
            </h5>

            <div class="row g-4">

                <div class="col-md-6">

                    <small class="text-muted">
                        Solicitante
                    </small>

                    <div class="fw-semibold">
                        @Model.SolicitanteUsuario.Nombre
                    </div>

                </div>


                <div class="col-md-6">

                    <small class="text-muted">
                        Departamento
                    </small>

                    <div class="fw-semibold">
                        @Model.DepartamentoCargo.Nombre
                    </div>

                </div>


                <div class="col-md-6">

                    <small class="text-muted">
                        Fecha de inicio
                    </small>

                    <div class="fw-semibold">
                        @Model.FechaHoraInicio.ToString("dd/MM/yyyy hh:mm tt")
                    </div>

                </div>


                <div class="col-md-6">

                    <small class="text-muted">
                        Fecha de finalización
                    </small>

                    <div class="fw-semibold">
                        @Model.FechaHoraFin.ToString("dd/MM/yyyy hh:mm tt")
                    </div>

                </div>


                <div class="col-md-6">

                    <small class="text-muted">
                        Salón
                    </small>

                    <div class="fw-semibold">
                        @Model.Salon.Nombre
                    </div>

                </div>


                <div class="col-md-6">

                    <small class="text-muted">
                        Cantidad de personas
                    </small>

                    <div class="fw-semibold">
                        @Model.CantidadPersonas
                    </div>

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.Otros))
            {
                <hr />

                <small class="text-muted">
                    Otros requerimientos
                </small>

                <p class="mb-0">
                    @Model.Otros
                </p>
            }

        </div>

    </div>


    <!-- MONTAJE -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                Montaje
            </h5>

            @if (Model.Montajes.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Tipo</th>
                                <th>Cantidad</th>
                                <th>Observaciones</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var montaje in Model.Montajes)
                        {
                            var sinMontaje =
                                montaje.TipoMontaje.Nombre == "Sin montaje";

                            <tr>

                                <td class="fw-semibold">
                                    @montaje.TipoMontaje.Nombre
                                </td>

                                <td>
                                    @(sinMontaje
                                        ? "-"
                                        : montaje.Cantidad)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        montaje.Observaciones)
                                        ? "-"
                                        : montaje.Observaciones)
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- SERVICIOS -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                Servicios
            </h5>

            @if (Model.Servicios.Any())
            {
                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead>
                            <tr>
                                <th>Servicio</th>
                                <th>Cantidad</th>
                                <th>Observaciones</th>
                            </tr>
                        </thead>

                        <tbody>

                        @foreach (var servicio in Model.Servicios)
                        {
                            var sinServicios =
                                servicio.Servicio.Nombre ==
                                "Sin servicios adicionales";

                            <tr>

                                <td class="fw-semibold">
                                    @servicio.Servicio.Nombre
                                </td>

                                <td>
                                    @(sinServicios
                                        ? "-"
                                        : servicio.Cantidad)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        servicio.Observaciones)
                                        ? "-"
                                        : servicio.Observaciones)
                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>


    <!-- ALIMENTACIÓN -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-3">
                Alimentación
            </h5>

            @if (Model.Alimentacion == null)
            {
                <p class="text-muted mb-0">
                    No se registró información.
                </p>
            }
            else if (!Model.Alimentacion.RequiereAlimentacion)
            {
                <p class="mb-0">
                    El evento no requiere alimentación.
                </p>
            }
            else
            {
                <div class="row g-4">

                    <div class="col-md-4">

                        <small class="text-muted">
                            Personas
                        </small>

                        <div class="fw-semibold">
                            @Model.Alimentacion.CantidadPersonas
                        </div>

                    </div>


                    <div class="col-md-4">

                        <small class="text-muted">
                            Hora
                        </small>

                        <div class="fw-semibold">
                            @(Model.Alimentacion.HoraServicio?.ToString("HH:mm") ?? "-")
                        </div>

                    </div>


                    <div class="col-md-4">

                        <small class="text-muted">
                            Detalle
                        </small>

                        <div class="fw-semibold">
                            @Model.Alimentacion.Detalle
                        </div>

                    </div>

                </div>


                <hr />


                <div class="d-flex gap-2 flex-wrap">

                    @if (Model.Alimentacion.IncluyeAgua)
                    {
                        <span class="badge bg-light text-dark border">
                            Agua
                        </span>
                    }

                    @if (Model.Alimentacion.IncluyeCafe)
                    {
                        <span class="badge bg-light text-dark border">
                            Café
                        </span>
                    }

                    @if (Model.Alimentacion.IncluyeRefrigerio)
                    {
                        <span class="badge bg-light text-dark border">
                            Refrigerio
                        </span>
                    }

                </div>
            }

        </div>

    </div>

<!-- HISTORIAL -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-4">

        <h5 class="fw-bold mb-4">
            Historial de la solicitud
        </h5>

        @if (Model.HistorialEstados.Any())
        {
            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>

                        <tr>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th>Actor</th>
                            <th>Comentario</th>
                        </tr>

                    </thead>

                    <tbody>

                    @foreach (var historial in
                        Model.HistorialEstados
                            .OrderByDescending(x => x.FechaCambio))
                    {
                        <tr>

                            <td>
                                @historial.FechaCambio
                                    .ToLocalTime()
                                    .ToString("dd/MM/yyyy hh:mm tt")
                            </td>

                            <td class="fw-semibold">
                                @historial.EstadoSolicitud.Nombre
                            </td>

                            <td>
                                @historial.Actor
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(
                                    historial.Comentario)
                                    ? "-"
                                    : historial.Comentario)
                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <p class="text-muted mb-0">
                No hay cambios de estado registrados.
            </p>
        }

    </div>

</div>

    <!-- ACCIONES -->
    <div class="d-flex justify-content-between align-items-center">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            ← Volver a coordinación

        </a>


        <div class="d-flex gap-2">

            @if (Model.Estado.Nombre == "Enviada")
            {
                <form asp-action="Revisar"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-warning">

                        Iniciar revisión

                    </button>

                </form>
            }


            @if (Model.Estado.Nombre == "En revisión")
            {
                <a asp-action="Rechazar"
   asp-route-id="@Model.Id"
   class="btn btn-outline-danger">

    Rechazar

</a>


                <form asp-action="Aprobar"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-success"
                            onclick="return confirm('¿Desea aprobar esta solicitud?');">

                        Aprobar

                    </button>

                </form>
            }

        </div>

    </div>

</div>