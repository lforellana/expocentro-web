@model Expocentro.Web.ViewModels.SolicitudEventoCreateViewModel

@{
    ViewData["Title"] = "Nueva solicitud";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="mb-4">
                <h1 class="fw-bold">Nueva solicitud de evento</h1>

                <p class="text-muted">
                    Registra los datos generales del evento interno.
                </p>
            </div>

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <form asp-action="Create" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="NombreEvento"
                                   class="form-label"></label>

                            <input asp-for="NombreEvento"
                                   class="form-control" />

                            <span asp-validation-for="NombreEvento"
                                  class="text-danger"></span>

                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label asp-for="FechaInicio"
                                       class="form-label"></label>

                                <input asp-for="FechaInicio"
                                       class="form-control" />

                            </div>

                            <div class="col-md-6">

                                <label asp-for="HoraInicio"
                                       class="form-label"></label>

                                <input asp-for="HoraInicio"
                                       class="form-control" />

                            </div>

                            <div class="col-md-6">

                                <label asp-for="FechaFin"
                                       class="form-label"></label>

                                <input asp-for="FechaFin"
                                       class="form-control" />

                            </div>

                            <div class="col-md-6">

                                <label asp-for="HoraFin"
                                       class="form-label"></label>

                                <input asp-for="HoraFin"
                                       class="form-control" />

                            </div>

                            <div class="col-md-6">

                                <label asp-for="SalonId"
                                       class="form-label"></label>

                                <select asp-for="SalonId"
                                        asp-items="Model.Salones"
                                        class="form-select">

                                    <option value="">
                                        Seleccione un salón
                                    </option>

                                </select>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="CantidadPersonas"
                                       class="form-label"></label>

                                <input asp-for="CantidadPersonas"
                                       class="form-control" />

                            </div>

                        </div>

                        <div class="mt-3">

                            <label asp-for="Otros"
                                   class="form-label"></label>

                            <textarea asp-for="Otros"
                                      class="form-control"
                                      rows="3"></textarea>

                        </div>

                        <div class="mt-3">

                            <label asp-for="Comentarios"
                                   class="form-label"></label>

                            <textarea asp-for="Comentarios"
                                      class="form-control"
                                      rows="3"></textarea>

                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Guardar solicitud
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}