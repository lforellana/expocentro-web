@model SolicitudEventoCreateViewModel
@{
    ViewData["Title"] = Model.EsEdicion ? "Editar solicitud" : "Nueva solicitud";
    var desdeResumen = ViewData["DesdeResumen"] as bool? ?? false;
}

<div class="page-header">
    <div>
        @if (Model.EsEdicion)
        {
            <div class="page-kicker">@Model.Codigo</div>
        }
        <h1>@(Model.EsEdicion ? "Editar datos generales" : "Nueva solicitud de evento")</h1>
        <p>¿Qué evento vas a realizar, cuándo y en qué salón?</p>
    </div>
</div>

<partial name="_PasosSolicitud" model="(1, Model.Id)" />

<form asp-action="@(Model.EsEdicion ? "Editar" : "Create")" method="post"
      data-disponibilidad="@Url.Action("Disponibilidad", "Calendario")"
      data-excluir-id="@Model.Id">

    <input type="hidden" asp-for="Id" />
    <input type="hidden" name="desdeResumen" value="@desdeResumen.ToString().ToLower()" />

    <div class="row g-4">
        <div class="col-xl-8">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <section class="ex-card mb-4">
                <div class="ex-card-body">
                    <h2 class="ex-section-title"><i class="bi bi-megaphone"></i> El evento</h2>

                    <div class="mb-3">
                        <label asp-for="NombreEvento" class="form-label"></label>
                        <input asp-for="NombreEvento" class="form-control" placeholder="Ej.: Capacitación de servicio al cliente" autofocus />
                        <span asp-validation-for="NombreEvento" class="text-danger small"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="DepartamentoCargoId" class="form-label"></label>
                            <select asp-for="DepartamentoCargoId" asp-items="Model.Departamentos" class="form-select">
                                <option value="0">Seleccione…</option>
                            </select>
                            <span asp-validation-for="DepartamentoCargoId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CantidadPersonas" class="form-label"></label>
                            <input asp-for="CantidadPersonas" class="form-control" min="1" />
                            <span asp-validation-for="CantidadPersonas" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
            </section>

            <section class="ex-card mb-4">
                <div class="ex-card-body">
                    <h2 class="ex-section-title"><i class="bi bi-calendar-event"></i> Fecha, hora y salón</h2>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="SalonId" class="form-label"></label>
                            <select asp-for="SalonId" asp-items="Model.Salones" class="form-select">
                                <option value="0">Seleccione un salón…</option>
                            </select>
                            <span asp-validation-for="SalonId" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label asp-for="FechaInicio" class="form-label"></label>
                            <input asp-for="FechaInicio" class="form-control" />
                            <span asp-validation-for="FechaInicio" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label asp-for="HoraInicio" class="form-label"></label>
                            <input asp-for="HoraInicio" class="form-control" step="900" />
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label asp-for="FechaFin" class="form-label"></label>
                            <input asp-for="FechaFin" class="form-control" />
                            <span asp-validation-for="FechaFin" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label asp-for="HoraFin" class="form-label"></label>
                            <input asp-for="HoraFin" class="form-control" step="900" />
                        </div>
                        <div class="col-12">
                            <div id="disponibilidad" class="disp-box" aria-live="polite"></div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="ex-card">
                <div class="ex-card-body">
                    <h2 class="ex-section-title"><i class="bi bi-chat-left-text"></i> Información adicional <span class="text-muted fw-normal small">(opcional)</span></h2>
                    <div class="mb-3">
                        <label asp-for="Otros" class="form-label"></label>
                        <textarea asp-for="Otros" class="form-control" rows="2" placeholder="Decoración, señalización, parqueo para invitados…"></textarea>
                    </div>
                    <div>
                        <label asp-for="Comentarios" class="form-label"></label>
                        <textarea asp-for="Comentarios" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </section>

            <div class="form-acciones">
                <a asp-action="@(Model.EsEdicion ? (desdeResumen ? "Resumen" : "Details") : "Index")"
                   asp-route-id="@Model.Id" class="btn btn-light">
                    Cancelar
                </a>
                <button type="submit" class="btn btn-primary px-4">
                    @(desdeResumen ? "Guardar y volver al resumen" : "Guardar y continuar")
                    <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="ex-card ex-card-body">
                <h2 class="ex-section-title"><i class="bi bi-lightbulb"></i> Antes de empezar</h2>
                <ul class="small text-muted ps-3 mb-3">
                    <li class="mb-2">Revisa en el <a asp-controller="Calendario" asp-action="Index" target="_blank">calendario</a> qué salones están libres.</li>
                    <li class="mb-2">Al elegir salón y horario verás aquí mismo si está disponible.</li>
                    <li class="mb-2">Puedes guardar y terminar después: la solicitud queda como <strong>borrador</strong> hasta que la envíes.</li>
                    <li>En los siguientes pasos indicarás montaje, servicios y alimentación.</li>
                </ul>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
