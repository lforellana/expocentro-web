@model SolicitudServicioViewModel
@{
    ViewData["Title"] = "Servicios";
    var desdeResumen = ViewData["DesdeResumen"] as bool? ?? false;
}

<div class="page-header">
    <div>
        <div class="page-kicker">@Model.Codigo</div>
        <h1>@Model.NombreEvento</h1>
        <p>¿Qué equipo o servicios necesitarás durante el evento?</p>
    </div>
</div>

<partial name="_PasosSolicitud" model="(3, (int?)Model.SolicitudEventoId)" />
<partial name="_Alertas" />

<form asp-action="Servicios" method="post">
    <input asp-for="SolicitudEventoId" type="hidden" />
    <input type="hidden" name="desdeResumen" value="@desdeResumen.ToString().ToLower()" />

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="row g-3" data-opciones>
        @for (var i = 0; i < Model.Servicios.Count; i++)
        {
            var item = Model.Servicios[i];
            var ninguna = item.Nombre == "Sin servicios adicionales";

            <div class="col-md-6 col-xl-4">
                <div class="opcion-card @(ninguna ? "opcion-ninguna" : "")" data-ninguna="@(ninguna ? "true" : "false")">
                    <input asp-for="Servicios[i].ServicioId" type="hidden" />

                    <div class="form-check">
                        <input asp-for="Servicios[i].Seleccionado" class="form-check-input" />
                        <label asp-for="Servicios[i].Seleccionado" class="form-check-label">
                            @if (ninguna)
                            {
                                <i class="bi bi-dash-circle me-1"></i>
                            }
                            @item.Nombre
                        </label>
                    </div>

                    @if (ninguna)
                    {
                        <input asp-for="Servicios[i].Cantidad" type="hidden" />
                        <div class="small text-muted mt-1 ps-4">No se requiere equipo adicional.</div>
                    }
                    else
                    {
                        <div class="opcion-detalle">
                            <div class="row g-2">
                                <div class="col-4">
                                    <label class="form-label small" asp-for="Servicios[i].Cantidad">Cantidad</label>
                                    <input asp-for="Servicios[i].Cantidad" class="form-control form-control-sm" min="1" />
                                </div>
                                <div class="col-8">
                                    <label class="form-label small" asp-for="Servicios[i].Observaciones">Observaciones</label>
                                    <input asp-for="Servicios[i].Observaciones" class="form-control form-control-sm" placeholder="Opcional" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="form-acciones">
        <a asp-action="@(desdeResumen ? "Resumen" : "Montaje")" asp-route-id="@Model.SolicitudEventoId" class="btn btn-light">
            <i class="bi bi-arrow-left me-1"></i> @(desdeResumen ? "Volver al resumen" : "Anterior")
        </a>
        <button type="submit" class="btn btn-primary px-4">
            @(desdeResumen ? "Guardar y volver al resumen" : "Guardar y continuar") <i class="bi bi-arrow-right ms-1"></i>
        </button>
    </div>
</form>
