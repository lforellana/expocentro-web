@model SolicitudEvento
@{
    ViewData["Title"] = "Resumen";
    ViewData["EnlacesEdicion"] = true;

    var disponibilidad = ViewData["Disponibilidad"] as ResultadoDisponibilidad;
    var faltantes = new List<string>();
    if (!Model.Montajes.Any()) faltantes.Add("montaje");
    if (!Model.Servicios.Any()) faltantes.Add("servicios");
    if (Model.Alimentacion == null) faltantes.Add("alimentación");

    var puedeEnviar = !faltantes.Any() && disponibilidad?.HayConflictoConfirmado != true;
}

<div class="page-header">
    <div>
        <div class="page-kicker">@Model.Codigo</div>
        <h1>@Model.NombreEvento</h1>
        <p>Revisa que todo esté correcto antes de enviar la solicitud a Coordinación.</p>
    </div>
    <partial name="_EstadoBadge" model="Model.Estado.Nombre" />
</div>

<partial name="_PasosSolicitud" model="(5, (int?)Model.Id)" />
<partial name="_Alertas" />

@if (disponibilidad != null)
{
    <partial name="_Conflictos" model="disponibilidad" />
}

@if (faltantes.Any())
{
    <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-1"></i>
        Falta completar: <strong>@string.Join(", ", faltantes)</strong>.
    </div>
}

<div class="row g-4">
    <div class="col-xl-8">
        <partial name="_DetalleEvento" model="Model" />
    </div>
    <div class="col-xl-4">
        <div class="ex-card ex-card-body position-sticky" style="top: 1.5rem">
            <h2 class="ex-section-title"><i class="bi bi-send"></i> Enviar solicitud</h2>
            <p class="small text-muted">
                Al enviarla ya no podrás modificarla. Coordinación la revisará y verás cada cambio de estado en el historial.
            </p>
            <form asp-action="Enviar" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-primary w-100 btn-lg" disabled="@(!puedeEnviar)">
                    <i class="bi bi-send me-1"></i> Enviar a Coordinación
                </button>
            </form>
            <div class="d-flex justify-content-between mt-3">
                <a asp-action="Alimentacion" asp-route-id="@Model.Id" class="btn btn-sm btn-light">
                    <i class="bi bi-arrow-left"></i> Anterior
                </a>
                <a asp-action="Index" class="btn btn-sm btn-light">Guardar borrador y salir</a>
            </div>
            <hr />
            <button type="button" class="btn btn-sm btn-link text-danger p-0" data-bs-toggle="modal" data-bs-target="#modalCancelar">
                Descartar esta solicitud
            </button>
        </div>
    </div>
</div>

<partial name="_CancelarModal" model='("Solicitudes", Model.Id, false)' />
