@model Expocentro.Web.Models.SolicitudEvento

@{
    ViewData["Title"] = "Detalle de solicitud";

    var badgeClass = Model.Estado.Nombre switch
    {
        "Borrador" => "bg-secondary",
        "Enviada" => "bg-primary",
        "En revisión" => "bg-warning text-dark",
        "Aprobada" => "bg-success",
        "Rechazada" => "bg-danger",
        _ => "bg-dark"
    };
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-start mb-4">

        <div>
            <p class="text-muted mb-1">
                @Model.Codigo
            </p>

            <h1 class="fw-bold">
                @Model.NombreEvento
            </h1>
        </div>

        <span class="badge @badgeClass px-3 py-2">
            @Model.Estado.Nombre
        </span>

    </div>

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body p-4">

            <h5 class="fw-bold mb-4">
                Datos generales
            </h5>
<div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h5 class="fw-bold mb-0">
                Montaje
            </h5>

            @if (Model.Estado.Nombre == "Borrador")
            {
                <a asp-action="Montaje"
                   asp-route-id="@Model.Id"
                   class="btn btn-sm btn-outline-primary">

                    Configurar montaje

                </a>
            }

        </div>

        @if (Model.Montajes.Any())
        {
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Tipo</th>
                            <th>Cantidad</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var montaje in Model.Montajes)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @montaje.TipoMontaje.Nombre
                            </td>

                            <td>
                                @montaje.Cantidad
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(montaje.Observaciones)
                                    ? "-"
                                    : montaje.Observaciones)
                            </td>
                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <p class="text-muted mb-0">
                No se ha configurado el montaje.
            </p>
        }

    </div>

<div class="card border-0 shadow-sm mb-4">

    <div class="card-body p-4">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <h5 class="fw-bold mb-0">
                Servicios
            </h5>

            @if (Model.Estado.Nombre == "Borrador")
            {
                <a asp-action="Servicios"
                   asp-route-id="@Model.Id"
                   class="btn btn-sm btn-outline-primary">

                    Configurar servicios

                </a>
            }

        </div>

        @if (Model.Servicios.Any())
        {
            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Servicio</th>
                            <th>Cantidad</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>

                    <tbody>

                    @foreach (var servicio in Model.Servicios)
                    {
                        <tr>

                            <td class="fw-semibold">
                                @servicio.Servicio.Nombre
                            </td>

                            <td>
                                @if (servicio.Servicio.Nombre ==
                                    "Sin servicios adicionales")
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    @servicio.Cantidad
                                }
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(servicio.Observaciones)
                                    ? "-"
                                    : servicio.Observaciones)
                            </td>

                        </tr>
                    }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <p class="text-muted mb-0">
                No se han configurado servicios.
            </p>
        }

    </div>

</div>

</div>
            <div class="row g-4">

                <div class="col-md-6">
                    <small class="text-muted">Fecha de inicio</small>
                    <div class="fw-semibold">
                        @Model.FechaHoraInicio.ToString("dd/MM/yyyy hh:mm tt")
                    </div>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Fecha de finalización</small>
                    <div class="fw-semibold">
                        @Model.FechaHoraFin.ToString("dd/MM/yyyy hh:mm tt")
                    </div>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Salón</small>
                    <div class="fw-semibold">
                        @Model.Salon.Nombre
                    </div>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Cantidad de personas</small>
                    <div class="fw-semibold">
                        @Model.CantidadPersonas
                    </div>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Solicitante</small>
                    <div class="fw-semibold">
                        @Model.SolicitanteUsuario.Nombre
                    </div>
                </div>

                <div class="col-md-6">
                    <small class="text-muted">Departamento</small>
                    <div class="fw-semibold">
                        @Model.DepartamentoCargo.Nombre
                    </div>
                </div>

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Otros))
            {
                <hr />

                <small class="text-muted">
                    Otros requerimientos
                </small>

                <p>
                    @Model.Otros
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Comentarios))
            {
                <small class="text-muted">
                    Comentarios
                </small>

                <p>
                    @Model.Comentarios
                </p>
            }

        </div>

    </div>

    <div class="d-flex justify-content-between align-items-center">

    <a asp-action="Index"
       class="btn btn-outline-secondary">
        ← Mis solicitudes
    </a>

    @if (Model.Estado.Nombre == "Borrador")
    {
        <form asp-action="Enviar"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="btn btn-success">
                Enviar solicitud
            </button>

        </form>
    }

</div>

</div>