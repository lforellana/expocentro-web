@model SolicitudEvento
@{
    ViewData["Title"] = Model.NombreEvento;

    var estado = Model.Estado.Nombre;
    var esBorrador = estado == Estados.Borrador;
    var cancelable = Estados.Cancelables.Contains(estado) && Model.FechaHoraFin >= Fechas.Ahora();

    var ultimoComentario = Model.HistorialEstados
        .OrderByDescending(x => x.FechaCambio)
        .FirstOrDefault()?.Comentario;

    var (icono, titulo, texto, clase) = estado switch
    {
        Estados.Borrador => ("bi-pencil", "Borrador sin enviar", "Completa los pasos pendientes y envíala a Coordinación.", "bg-soft-secondary"),
        Estados.Enviada => ("bi-send", "Enviada a Coordinación", "Tu solicitud está en cola para ser revisada.", "bg-soft-primary"),
        Estados.EnRevision => ("bi-hourglass-split", "En revisión", "Coordinación está revisando tu solicitud.", "bg-soft-warning"),
        Estados.Aprobada => ("bi-check-circle", "¡Aprobada!", "El salón está reservado para tu evento.", "bg-soft-success"),
        Estados.Rechazada => ("bi-x-circle", "Rechazada", ultimoComentario ?? "", "bg-soft-danger"),
        Estados.Cancelada => ("bi-slash-circle", "Cancelada", ultimoComentario ?? "", "bg-soft-secondary"),
        _ => ("bi-circle", estado, "", "bg-soft-secondary")
    };
}

<div class="page-header">
    <div>
        <div class="page-kicker">
            <a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left"></i> Mis solicitudes</a>
            · @Model.Codigo
        </div>
        <h1>@Model.NombreEvento</h1>
        <p>@Fechas.Rango(Model.FechaHoraInicio, Model.FechaHoraFin) · @Model.Salon.Nombre</p>
    </div>
    <partial name="_EstadoBadge" model="estado" />
</div>

<partial name="_Alertas" />

<div class="row g-4">
    <div class="col-xl-8">
        <div class="ex-card ex-card-body d-flex gap-3 align-items-center mb-4">
            <span class="stat-icon @clase"><i class="bi @icono"></i></span>
            <div class="min-w-0">
                <div class="fw-bold">@titulo</div>
                @if (!string.IsNullOrWhiteSpace(texto))
                {
                    <div class="text-muted small">@texto</div>
                }
            </div>
            @if (esBorrador)
            {
                <a asp-action="Resumen" asp-route-id="@Model.Id" class="btn btn-primary ms-auto text-nowrap">
                    Continuar <i class="bi bi-arrow-right"></i>
                </a>
            }
        </div>

        @{ ViewData["EnlacesEdicion"] = esBorrador; }
        <partial name="_DetalleEvento" model="Model" />
    </div>

    <div class="col-xl-4">
        <partial name="_Historial" model="Model.HistorialEstados" />

        @if (cancelable)
        {
            <div class="text-center mt-3">
                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalCancelar">
                    <i class="bi bi-slash-circle me-1"></i> Cancelar solicitud
                </button>
            </div>
        }
    </div>
</div>

@if (cancelable)
{
    <partial name="_CancelarModal" model='("Solicitudes", Model.Id, !esBorrador)' />
}
