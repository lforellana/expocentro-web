@model IEnumerable<SolicitudEvento>
@{
    ViewData["Title"] = "Mis solicitudes";
    var estadoActual = ViewData["Estado"] as string ?? "";

    var pestanas = new (string Valor, string Texto)[]
    {
        ("", "Todas"),
        (Estados.Borrador, "Borradores"),
        ("pendientes", "En trámite"),
        (Estados.Aprobada, "Aprobadas"),
        ("cerradas", "Rechazadas / canceladas")
    };
}

<div class="page-header">
    <div>
        <h1>Mis solicitudes</h1>
        <p>Eventos internos que has registrado y su estado actual.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Nueva solicitud
    </a>
</div>

<partial name="_Alertas" />

<div class="ex-tabs">
    @foreach (var p in pestanas)
    {
        <a class="@(p.Valor == estadoActual ? "active" : "")" asp-action="Index" asp-route-estado="@p.Valor">@p.Texto</a>
    }
</div>

<section class="ex-card">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-ex">
                <thead>
                    <tr>
                        <th>Evento</th>
                        <th>Fecha</th>
                        <th>Salón</th>
                        <th class="text-end">Personas</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        var esBorrador = s.Estado.Nombre == Estados.Borrador;
                        <tr data-href="@Url.Action("Details", new { id = s.Id })">
                            <td>
                                <div class="fw-semibold">@s.NombreEvento</div>
                                <div class="small text-muted">@s.Codigo</div>
                            </td>
                            <td class="text-nowrap">@Fechas.Rango(s.FechaHoraInicio, s.FechaHoraFin)</td>
                            <td>@s.Salon.Nombre</td>
                            <td class="text-end">@s.CantidadPersonas</td>
                            <td><partial name="_EstadoBadge" model="s.Estado.Nombre" /></td>
                            <td class="text-end text-nowrap">
                                @if (esBorrador)
                                {
                                    <a asp-action="Resumen" asp-route-id="@s.Id" class="btn btn-sm btn-primary">
                                        Continuar <i class="bi bi-arrow-right"></i>
                                    </a>
                                }
                                else
                                {
                                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-light">Ver</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="vacio">
            <i class="bi bi-inbox"></i>
            <h3>No hay solicitudes en esta vista</h3>
            <p>Cuando registres un evento aparecerá aquí con su estado.</p>
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Nueva solicitud</a>
        </div>
    }
</section>
