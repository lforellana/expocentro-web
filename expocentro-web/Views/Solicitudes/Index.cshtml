@model IEnumerable<Expocentro.Web.Models.SolicitudEvento>

@{
    ViewData["Title"] = "Mis solicitudes";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                Mis solicitudes
            </h1>

            <p class="text-muted mb-0">
                Eventos internos registrados.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            + Nueva solicitud

        </a>

    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    <div class="card border-0 shadow-sm">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Código</th>
                        <th>Evento</th>
                        <th>Fecha</th>
                        <th>Salón</th>
                        <th>Personas</th>
                        <th>Estado</th>
                    </tr>

                </thead>

                <tbody>

                @foreach (var solicitud in Model)
                {
                    <tr>

                        <td>
                            @solicitud.Codigo
                        </td>

                        <td class="fw-semibold">
                            @solicitud.NombreEvento
                        </td>

                        <td>
                            @solicitud.FechaHoraInicio.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            @solicitud.Salon.Nombre
                        </td>

                        <td>
                            @solicitud.CantidadPersonas
                        </td>

                        <td>
                            <span class="badge bg-secondary">
                                @solicitud.Estado.Nombre
                            </span>
                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>

</div>